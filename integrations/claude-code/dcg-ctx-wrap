#!/usr/bin/env python3
"""
dcg-ctx-wrap — Claude Code PreToolUse adapter for context-mode ctx_execute.

context-mode's ctx_execute tool runs arbitrary shell/python/js/etc code in a
sandbox. The DCG hook is wired only for Bash, so ctx_execute became a wide-open
emission channel and let `infisical secrets --plain` through on 2026-05-15.

This adapter:
1. Reads Claude Code hook JSON from stdin.
2. If tool_name is mcp__context-mode__ctx_execute or _execute_file, extracts
   tool_input.code (and language) and rewrites the payload as a synthetic Bash
   call so dcg's existing pattern packs run against the code text verbatim.
3. Pipes the rewritten payload to dcg-wrap, which runs dcg + Discord alerting.
4. Emits dcg-wrap's decision back to Claude Code unchanged.

For non-shell languages (javascript/python/etc), dcg's regex patterns scan
the raw source — substrings like `infisical secrets --plain` will match
whether they appear in `bash` or in a JS `execSync(...)` string. This is
intentional: defends against the same leak vector in any wrapping language.

If anything in the adapter path errors, we FAIL OPEN with continue:true. The
adapter must never block real work because of its own bugs; dcg-wrap remains
the load-bearing safety layer.

Tracked under: transformate WI-117 SEC-V1 Phase 1.
"""

import json
import os
import subprocess
import sys

DCG_WRAP = os.environ.get(
    "DCG_WRAP_BIN",
    os.path.join(os.path.expanduser("~"), ".local/bin/dcg-wrap"),
)
CTX_TOOLS = {
    "mcp__context-mode__ctx_execute",
    "mcp__context-mode__ctx_execute_file",
}


def fail_open():
    """Emit a continue:true decision so Claude Code proceeds."""
    print(json.dumps({"continue": True}))
    sys.exit(0)


def main():
    try:
        raw = sys.stdin.read()
        inp = json.loads(raw)
    except Exception:
        fail_open()

    tool = inp.get("tool_name") or inp.get("toolName") or ""
    if tool not in CTX_TOOLS:
        fail_open()

    ti = inp.get("tool_input") or inp.get("toolInput") or {}
    if not isinstance(ti, dict):
        fail_open()

    code = ti.get("code") or ""
    if not isinstance(code, str) or not code.strip():
        fail_open()

    language = ti.get("language") or ""
    synthetic = {
        "tool_name": "Bash",
        "tool_input": {
            "command": code,
            "_dcg_source_tool": tool,
            "_dcg_source_language": language,
        },
    }

    try:
        proc = subprocess.run(
            [DCG_WRAP],
            input=json.dumps(synthetic),
            capture_output=True,
            text=True,
            timeout=8,
        )
    except Exception:
        fail_open()

    sys.stdout.write(proc.stdout)
    sys.stderr.write(proc.stderr)
    sys.exit(proc.returncode)


if __name__ == "__main__":
    main()
